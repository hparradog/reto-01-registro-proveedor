# Proveedor del modelo de lenguaje: openrouter | anthropic | mock
LLM_PROVIDER=openrouter

# OpenRouter (recomendado). La clave se crea en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# URL pública del despliegue; OpenRouter la usa solo para identificar la app (opcional)
OPENROUTER_APP_URL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Alternativa: API directa de Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

PORT=3000

# Límites del ciclo del agente
AGENT_MAX_ITERATIONS=25
AGENT_MAX_OUTPUT_TOKENS=4096
SESSION_TOKEN_LIMIT=200000
LLM_TIMEOUT_MS=60000
MAX_MESSAGE_CHARS=4000
RATE_LIMIT_PER_MINUTE=20

# Fecha usada para evaluar vigencias (YYYY-MM-DD). Vacía = fecha real.
# Para reproducir los resultados del PRD usar 2026-09-03.
FECHA_REFERENCIA=

# Si se define, el front y la API exigen esta clave (header x-access-key).
ACCESS_KEY=
